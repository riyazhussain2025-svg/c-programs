#include<stdio.h>
int main()
{
	char op;
	int a, b;
	
	printf("enter the operator:");
	scanf("%c",&op);
	printf("enter two numbers:");
	scanf("%d %d",&a,&b);
	
	switch(op){
	
			case'+': printf("%d",a+b);
			break;
			
			case'-':printf("%d",a-b);
			break;
			
			case'*':printf("%d",a*b);
			break;
			
			case'/':printf("%d",a/b);
			break;
			
			default:printf("invalid");
			break;
	}
	return 0 ;
}
